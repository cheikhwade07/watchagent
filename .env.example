# Copy this file to .env and adjust as needed. Never commit a real .env.

# Filesystem path to the SQLite database file.
#   - Docker: docker-compose overrides this to /data/watchagent.db so the
#     database persists on the mounted /data volume across restarts.
#   - Local (outside Docker): defaults to ./data/watchagent.db relative to the
#     project root. The parent directory is created automatically.
WATCHAGENT_DB_PATH=./data/watchagent.db

# How often (in seconds) the in-process poller fetches each city.
WATCHAGENT_POLL_INTERVAL_SECONDS=120

# Whether the in-process poller starts with the app. Set to false to disable
# polling (the test suite sets this to false so no real Open-Meteo calls run).
POLLER_ENABLED=true
