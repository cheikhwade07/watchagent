# Copy this file to .env and adjust as needed. Never commit a real .env.

# Filesystem path to the SQLite database file.
#   - Docker: this value is IGNORED. docker-compose sets an explicit
#     `environment: WATCHAGENT_DB_PATH=/data/watchagent.db`, and an explicit
#     environment value overrides env_file, so the container always writes to
#     the mounted /data named volume and the DB persists across restarts.
#   - Local (outside Docker): this ./data/watchagent.db default is used,
#     relative to the project root. The parent directory is created
#     automatically.
WATCHAGENT_DB_PATH=./data/watchagent.db

# How often (in seconds) the in-process poller fetches each city.
WATCHAGENT_POLL_INTERVAL_SECONDS=120

# Whether the in-process poller starts with the app. Set to false to disable
# polling (the test suite sets this to false so no real Open-Meteo calls run).
POLLER_ENABLED=true
